# Copy this file to .env.local, fill in what you want, and restart the dev
# server. Everything here is optional — with none of it set, OpenChapter runs
# the way it always has: entirely in this browser, no sign-in, no assistant.

# --- The model, for every screen that needs one -----------------------------
# One choice covers the lot: the assistant panel in the editor, ranked comps,
# shop categories, keyword suggestions, the blurb workshop and the blurb
# critique. Either key below works and ANTHROPIC_API_KEY wins when both are
# set, so adding it later takes over with no code change. Without either, all
# of them answer 501 and say so; everything around them keeps working — the
# comp *search* itself needs no key at all.
#
# Google's is free to start: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# Get an Anthropic key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
#
# Two models are chosen, because the callers are two different jobs: the short
# bounded ones (comps, categories, keywords, blurb) and the assistant, which
# reasons about your prose and gets the larger model. Override either without
# touching the other — an unset one keeps its default.
# OPENCHAPTER_MODEL=gemini-3.6-flash
# OPENCHAPTER_CHAT_MODEL=gemini-3.6-flash

# --- Audiobooks, both directions -------------------------------------------
# Audio in: a recording becomes a chaptered book (/api/transcribe).
# Audio out: a book is read aloud as one MP3 per chapter (/api/narrate).
#
# Without this key both answer 501 and say so, the same as the assistant above.
#
# One key covers both: the Vercel AI Gateway serves the transcription models
# (openai/gpt-4o-transcribe) and the speech ones (openai/tts-1), so there is no
# second vendor account. Billed per minute of audio in, per character out.
# Get a key at https://vercel.com/[team]/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=

# --- Accounts --------------------------------------------------------------
# Set both to turn sign-in on. Leave both empty and the app has no accounts at
# all: no sign-in wall, and the account menu says so plainly.
#
# Find them in your Supabase dashboard under Project Settings → API Keys.
# Both are meant to reach the browser — the publishable key grants nothing on
# its own, since row-level security is what decides who may read what. Never
# put the secret key here: Next inlines every NEXT_PUBLIC_ variable into the
# bundle it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The secret key, for the two callers that cannot go through row-level security.
#
# PayHere's payment notification arrives as a POST from PayHere's servers with no
# session, and it is the only thing allowed to write a subscription. And sharing
# a book: `book_members` grants the browser a column-limited select and no write
# at all, because the seat cap depends on isPro() — so inviting, accepting,
# changing a role and removing somebody all run server-side with this key.
#
# Without it, sharing is unavailable and says so rather than failing on a press.
#
# Never name this with a NEXT_PUBLIC_ prefix and never paste it into client
# code. Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Payments (Paddle) ------------------------------------------------------
# The gateway new checkouts go through. Leave every one of these empty and the
# app falls back to PayHere below; leave both sets empty and there are no plans
# at all — nothing is for sale, nothing is held back, and the Upgrade button
# says so.
#
# Paddle is here because PayHere cannot sell a subscription without a Sri Lankan
# business registration and a LKR 3,990/month plan, and Paddle costs nothing
# until it is paid. It is also a merchant of record, so worldwide sales tax is
# its problem rather than yours. TODO.md records when that stops being the
# cheaper answer — around eighteen subscribers.
#
# All five are required together: a client token with no API key opens a
# checkout nothing can create, and an API key with no webhook secret takes
# payments nobody is granted for. isPaddleConfigured() checks all five.

# sandbox (the default and the safe way round) or production. Anything other
# than the exact word "production" is the sandbox, so a typo cannot take a real
# card. Sandbox and live have entirely separate keys, tokens and price ids.
PADDLE_ENV=sandbox

# Paddle dashboard → Developer tools → Authentication.
PADDLE_API_KEY=

# Developer tools → Notifications → your destination → the endpoint secret key,
# `pdl_ntfset_…`. The only thing separating a real notification from a POST
# anybody can make: the webhook URL is public and its body is attacker-shaped.
PADDLE_WEBHOOK_SECRET=

# Developer tools → Authentication → client-side tokens. Public by design —
# Paddle.js needs it in the browser and it can do nothing but open a checkout.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Catalog → Products → your two prices, `pri_…`. Server-side on purpose: the
# transaction is created by our own route, so the price a writer is charged
# cannot be swapped for a cheaper one by anybody reading the page source.
# Their amounts must match src/lib/billing/plans.ts — Paddle charges what its
# own price says, and the pricing page prints what plans.ts says.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_ANNUAL=

# Paddle posts notifications to /api/billing/paddle/notify. There is no separate
# URL setting: you paste that address into the notification destination in
# Paddle's dashboard. Locally that means a tunnel, the same as PayHere — Paddle's
# servers cannot reach localhost either.

# --- Payments (PayHere) ----------------------------------------------------
# The other gateway, kept because it is sandbox-verified end to end and its
# 2.99% beats a merchant of record's percentage once there are enough
# subscribers to outweigh its LKR 3,990/month. Used only when the Paddle block
# above is empty. A writer who subscribed here keeps being cancelled here after
# new checkouts have moved, because the subscriptions row records which gateway
# it was.
#
# From your PayHere merchant portal, under Settings → Domains & Credentials.
# The domain has to be approved there before a checkout from it will be taken.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# sandbox (the default, and the safe way round) or live. Anything other than
# the exact word "live" means the sandbox, so a typo cannot charge a real card.
PAYHERE_MODE=sandbox

# LKR or USD — the two PayHere takes on a *recurring* payment. Defaults to USD.
# The pricing page reads this too, so the figure on the card and the figure on
# the statement come from one place. Prices live in src/lib/billing/plans.ts.
NEXT_PUBLIC_PAYHERE_CURRENCY=USD

# Where PayHere sends the writer back to and where it POSTs the notification,
# so it has to be the app's real public address — not a relative path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, and the way to test payments locally: point the notification at a
# tunnel (ngrok, cloudflared) while the app itself stays on localhost. PayHere's
# servers make this call, and nothing outside your machine can reach localhost.
# PAYHERE_NOTIFY_URL=https://your-tunnel.ngrok-free.app/api/billing/notify

# Optional. A second pair, made under the same Domains & Credentials screen,
# for the Subscription Manager API. Only cancelling from inside the app needs
# them — without them the account dialog shows no Cancel button rather than one
# that cannot work, and a writer cancels from PayHere's own receipt email.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# --- Comparable titles (optional) -------------------------------------------
# The comp-titles search reads two free services: Open Library, which needs
# nothing at all, and Google Books, which works without a key and rate-limits
# hard without one — the anonymous quota is per IP, and a server is one IP for
# every writer using it, so it starts answering 429 under any real traffic.
#
# Leave this empty and the feature still works: Open Library carries it, and
# the panel says plainly that Google did not answer rather than implying that
# nothing like your book exists. Set it and both halves work.
#
# Free, from console.cloud.google.com — enable the Books API, then create an
# API key. No billing account required.
GOOGLE_BOOKS_API_KEY=

# ---------------------------------------------------------------------------
# Email — invitations to a shared book
# ---------------------------------------------------------------------------
#
# Optional, like everything else here. Without it, sharing works exactly as it
# did before mail existed: the invitation is created, the owner copies the link
# and passes it on, and the dialog says plainly that no email went. With it,
# the invitee is emailed as well and the link stays as the fallback.
#
# Resend is the provider because it is the only messaging integration in
# Vercel's marketplace (`vercel integration add resend/resend-email`), which
# also sets this variable on the project for you.
#
# The failure mode worth knowing: a send never breaks an invitation. The row in
# book_members is what grants access, so a missing key, a refused request or a
# provider outage all end the same way — the invitation exists, `emailed` comes
# back false, and the writer is shown the link instead.
RESEND_API_KEY=

# The sending domain, written by the same `vercel integration add`. Must be
# **verified in Resend** — DKIM and SPF records on DNS — or every send is
# refused. A gmail.com address cannot be used: you have to control the DNS.
# Resend's own advice is a subdomain (mail.example.com) rather than the apex,
# so the sending reputation is isolated and the SPF record cannot collide with
# one the apex already carries for ordinary business mail.
RESEND_EMAIL_DOMAIN=

# Overrides the whole From line, where the local part or the display name has
# to be something other than the default `OpenChapter <invites@$DOMAIN>`.
#
# The inviter's own name rides in the display name ("Ada Vance (via
# OpenChapter)") and their address goes in Reply-To. Sending *as* their address
# would fail DKIM and DMARC, and is how a sending domain gets flagged for
# spoofing — so this is our domain, never theirs.
# RESEND_FROM=OpenChapter <invites@openchapterapp.com>

# Where Chrome is, for the PDF export.
#
# `/api/export/pdf` lays the book out in a real browser and returns the file.
# It has to: Paged.js works out each contents folio by asking
# `window.getComputedStyle` which page a chapter landed on, and in the hidden
# iframe the export used before, that question was being put to the wrong
# document — so every page number in the contents printed as 0, and long
# contents lists lost most of their entries.
#
# Unset on a deployment, `@sparticuz/chromium` supplies its own binary. Unset
# with no binary either, the route answers 501 and the export falls back to the
# browser's print dialog exactly as it did before — so this is optional like
# every other key here, and leaving it out costs the folios, not the export.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
