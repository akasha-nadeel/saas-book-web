# Copy this file to .env.local, fill in what you want, and restart the dev
# server. Everything here is optional — with none of it set, OpenChapter runs
# the way it always has: entirely in this browser, no sign-in, no assistant.

# --- The assistant, and ranking comps --------------------------------------
# Two features send prose, and both are pressed rather than automatic: the
# assistant panel in the editor, and "Rank these" on the comp titles screen —
# which sends your blurb and the opening of your first chapter so a model can
# say which of the search results are genuinely like your book (/api/comps/rank).
# Without this key both answer 501 and say so; the comp *search* itself needs
# no key and keeps working.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Audiobooks, both directions -------------------------------------------
# Audio in: a recording becomes a chaptered book (/api/transcribe).
# Audio out: a book is read aloud as one MP3 per chapter (/api/narrate).
#
# Without this key both answer 501 and say so, the same as the assistant above.
#
# One key covers both: the Vercel AI Gateway serves the transcription models
# (openai/gpt-4o-transcribe) and the speech ones (openai/tts-1), so there is no
# second vendor account. Billed per minute of audio in, per character out.
# Get a key at https://vercel.com/[team]/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=

# --- Accounts --------------------------------------------------------------
# Set both to turn sign-in on. Leave both empty and the app has no accounts at
# all: no sign-in wall, and the account menu says so plainly.
#
# Find them in your Supabase dashboard under Project Settings → API Keys.
# Both are meant to reach the browser — the publishable key grants nothing on
# its own, since row-level security is what decides who may read what. Never
# put the secret key here: Next inlines every NEXT_PUBLIC_ variable into the
# bundle it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The secret key, for the one caller that has no user: PayHere's payment
# notification. It arrives as a POST from PayHere's servers with no session, and
# it is the only thing allowed to write a subscription — so it uses this key,
# which row-level security does not apply to.
#
# Never name this with a NEXT_PUBLIC_ prefix and never paste it into client
# code. Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Payments (PayHere) ----------------------------------------------------
# Leave these empty and the app has no plans: nothing is for sale, nothing is
# held back, and the Upgrade button says so. Set them and the assistant, the
# audiobook (both directions) and the bookmarks panel move onto the paid plan.
#
# From your PayHere merchant portal, under Settings → Domains & Credentials.
# The domain has to be approved there before a checkout from it will be taken.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# sandbox (the default, and the safe way round) or live. Anything other than
# the exact word "live" means the sandbox, so a typo cannot charge a real card.
PAYHERE_MODE=sandbox

# LKR or USD — the two PayHere takes on a *recurring* payment. Defaults to USD.
# The pricing page reads this too, so the figure on the card and the figure on
# the statement come from one place. Prices live in src/lib/billing/plans.ts.
NEXT_PUBLIC_PAYHERE_CURRENCY=USD

# Where PayHere sends the writer back to and where it POSTs the notification,
# so it has to be the app's real public address — not a relative path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, and the way to test payments locally: point the notification at a
# tunnel (ngrok, cloudflared) while the app itself stays on localhost. PayHere's
# servers make this call, and nothing outside your machine can reach localhost.
# PAYHERE_NOTIFY_URL=https://your-tunnel.ngrok-free.app/api/billing/notify

# Optional. A second pair, made under the same Domains & Credentials screen,
# for the Subscription Manager API. Only cancelling from inside the app needs
# them — without them the account dialog shows no Cancel button rather than one
# that cannot work, and a writer cancels from PayHere's own receipt email.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# --- Comparable titles (optional) -------------------------------------------
# The comp-titles search reads two free services: Open Library, which needs
# nothing at all, and Google Books, which works without a key and rate-limits
# hard without one — the anonymous quota is per IP, and a server is one IP for
# every writer using it, so it starts answering 429 under any real traffic.
#
# Leave this empty and the feature still works: Open Library carries it, and
# the panel says plainly that Google did not answer rather than implying that
# nothing like your book exists. Set it and both halves work.
#
# Free, from console.cloud.google.com — enable the Books API, then create an
# API key. No billing account required.
GOOGLE_BOOKS_API_KEY=
