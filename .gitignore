# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but the example, which holds no secret, should be committed.
!.env.local.example

.vercel

# local dev server log
.dev.log

.env*

# Per-machine Claude Code permissions. `settings.local.json` is local by name
# and by content — it accumulates absolute paths into this machine's temp
# directories, which mean nothing to anybody else.
.claude/settings.local.json

# A scratch copy of the app, with its own .next/ build output in it. Untracked
# and never meant to ship: without this a `git add .` commits thousands of
# bundled files, and it is what made `npm run lint` report 7303 problems
# against the three that are actually in src/.
/.shot-app/

# Vendored third-party skill documentation, fetched by tooling and pinned by
# `skills-lock.json` — which is committed, so the set is reproducible without
# carrying ~120 files of somebody else's docs in an app repo. The two
# directories are copies of each other.
/.agents/
/.claude/

# The Supabase CLI's scratch (a version stamp it refreshes on every run).
supabase/.temp/

# Hand-made backups of the instruction file. Useful on the machine that made
# one, noise in the history: a second, stale copy of CLAUDE.md that nothing
# reads and that goes out of date the moment the real one changes.
CLAUDE.md.backup-*
